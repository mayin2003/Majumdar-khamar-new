# Supabase Configuration
# Obtain these from your Supabase Project Dashboard -> Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional Admin Email Allowlist (comma-separated if multiple)
# Restricts Admin Panel access to this email address
VITE_ADMIN_EMAIL="admin@majumdarkhamar.com"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
